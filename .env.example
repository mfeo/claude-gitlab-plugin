# Set these in your shell rc (~/.zshrc, ~/.bashrc) or in ~/.claude/settings.json:
#
#   "env": {
#     "GITLAB_URL": "https://gitlab.example.com/api/v4",
#     "GITLAB_TOKEN": "glpat-xxxxxxxxxxxxxxxxxxxx"
#   }
#
# ~/.zshrc / ~/.bashrc:
export GITLAB_URL="https://gitlab.example.com/api/v4"
export GITLAB_TOKEN="glpat-xxxxxxxxxxxxxxxxxxxx"

# Optional — max diff lines shown per file when using --diff (default: 500)
# export MAX_DIFF_LINES_PER_FILE=500
